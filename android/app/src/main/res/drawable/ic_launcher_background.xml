<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background: the sky from the art target, top to bottom.
  Violet overhead, the warm band pinned low, exactly the ordering the sky
  shader uses (see src/world/view/sky.ts). An adaptive icon crops its
  background to whatever mask the launcher uses, so this is a plain gradient
  with nothing in it that can be cut in half.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF2B2350" />
                <item android:offset="0.42" android:color="#FF8C6A93" />
                <item android:offset="0.70" android:color="#FFEE8352" />
                <item android:offset="1" android:color="#FFFBC36B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
