<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground: a ridge line and a road running into it.

  Adaptive icons only guarantee the central 72 of these 108 units, so the road
  and the horizon live there; the ridge and the ground run the full width so
  that a launcher using a generous mask finds land rather than a cut edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Far ridge: low contrast, washed toward the sky. -->
    <path
        android:fillColor="#FF6E5A84"
        android:pathData="M0,62 L16,55 L30,60 L46,49 L60,58 L76,51 L92,59 L108,54 L108,72 L0,72 Z" />

    <!-- Ground. -->
    <path
        android:fillColor="#FF241D31"
        android:pathData="M0,64 L20,61 L44,65 L70,60 L90,64 L108,62 L108,108 L0,108 Z" />

    <!-- The road, converging on the horizon. -->
    <path
        android:fillColor="#FF3E3750"
        android:pathData="M50,63 L58,63 L82,108 L26,108 Z" />

    <!-- Centre line, in two dashes so it reads as motion. -->
    <path
        android:fillColor="#FFF6CE7E"
        android:pathData="M53.1,70 L55.4,70 L56.4,79 L52,79 Z M51.4,85 L56.9,85 L58.6,99 L49.6,99 Z" />
</vector>
